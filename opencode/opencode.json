{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "gitlab/duo-chat-haiku-4-5",
  "share": "disabled",
  "autoupdate": false,
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/AGENTS.local.md"
  ],
  "plugin": [
    "@gitlab/opencode-gitlab-plugin"
  ],
  "mcp": {
    "glean": {
      "type": "remote",
      "url": "https://gitlab-be.glean.com/mcp/default",
      "enabled": true
    }
  },
  "agent": {
    "plan": {
      "model": "gitlab/duo-chat-opus-5"
    },
    "build": {
      "model": "gitlab/duo-chat-gpt-5-6-sol"
    },
    "explore": {
      "model": "gitlab/duo-chat-sonnet-5"
    },
    "general": {
      "model": "gitlab/duo-chat-sonnet-5"
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "ask",
      "~/.aws/**": "ask",
      "~/.gnupg/**": "ask"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "sudo *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git checkout -- *": "ask",
      "git rebase*": "ask",
      "git filter-branch*": "ask",
      "*curl*|*sh*": "ask",
      "*wget*|*sh*": "ask",
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "dd *": "ask",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "brew uninstall *": "ask",
      "npm publish*": "ask",
      "gem push*": "ask",
      "docker system prune*": "ask",
      "kubectl delete *": "ask",
      "terraform apply*": "ask",
      "terraform destroy*": "ask",
      "psql *DROP*": "ask",
      "*history -c*": "ask"
    },
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow"
  }
}
