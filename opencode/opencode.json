{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "gitlab/duo-chat-haiku-4-5",
  "share": "disabled",
  "autoupdate": false,
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/AGENTS.local.md"
  ],
  "permission": {
    "*": "ask",
    "external_directory": {
      "~/.dotfiles/**": "allow",
      "~/workspace/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/*/*/T/opencode/**": "allow",
      "/private/var/folders/*/*/T/opencode/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git fetch*": "allow",
      "ls*": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "bundle exec rspec *": "allow",
      "bin/rubocop*": "allow",
      "git add *": "allow",
      "git commit *": "allow"
    },
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "skill": "allow"
  }
}
