{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "update": "disable",
  "plugins": [
    "opencode-gitlab-plugin"
  ],
  "mcp": {
    "servers": {
      "glean": {
        "type": "remote",
        "url": "https://gitlab-be.glean.com/mcp/default",
        "disabled": false
      }
    }
  },
  "agents": {
    "plan": {
      "model": "gitlab/duo-chat-opus-5"
    },
    "build": {
      "model": "gitlab/duo-chat-gpt-5-6-sol"
    },
    "explore": {
      "model": "gitlab/duo-chat-sonnet-5"
    },
    "general": {
      "model": "gitlab/duo-chat-sonnet-5"
    },
    "title": {
      "model": "gitlab/duo-chat-haiku-4-5"
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.aws/**", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.gnupg/**", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm -fr *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase*", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch*", "effect": "ask" },
    { "action": "shell", "resource": "*curl*|*sh*", "effect": "ask" },
    { "action": "shell", "resource": "*wget*|*sh*", "effect": "ask" },
    { "action": "shell", "resource": "chmod -R *", "effect": "ask" },
    { "action": "shell", "resource": "chown -R *", "effect": "ask" },
    { "action": "shell", "resource": "dd *", "effect": "ask" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown*", "effect": "deny" },
    { "action": "shell", "resource": "reboot*", "effect": "deny" },
    { "action": "shell", "resource": "brew uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "npm publish*", "effect": "ask" },
    { "action": "shell", "resource": "gem push*", "effect": "ask" },
    { "action": "shell", "resource": "docker system prune*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "ask" },
    { "action": "shell", "resource": "terraform apply*", "effect": "ask" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "ask" },
    { "action": "shell", "resource": "psql *DROP*", "effect": "ask" },
    { "action": "shell", "resource": "*history -c*", "effect": "ask" }
  ]
}
